# Copy to .env and change values before use.
# Never commit a real .env file.

DATABASE_PATH=backend/data/safeops.db
ADMIN_TOKEN=change-me-before-use
CORS_ORIGINS=http://localhost:3000

DEMO_MODE=true
LLM_PROVIDER=demo
